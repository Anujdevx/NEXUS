# Copy to .env.local (gitignored). Every variable is optional.
# Where the REST API and the live WebSocket are. The Vite dev server proxies /api and /ws to the gateway
# (NEXUS_GATEWAY, default http://localhost:8000), so the defaults need no CORS.
VITE_API_URL=/api/v1
VITE_WS_URL=/ws/v1/live
# auto: use the backend when it answers, fall back to the local engine when it does not (default)
# on:   same as auto, but log live/local switches to the console
# off:  never call the backend; the console runs only on its local engine
VITE_LIVE=auto
